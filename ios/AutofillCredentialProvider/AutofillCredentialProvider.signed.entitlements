<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Use this entitlements file when building with an Apple Developer Team.
  In Xcode: select AutofillCredentialProvider → Signing & Capabilities →
  add "AutoFill Credential Provider" and App Group group.com.openselfhosting.openkey,
  then set CODE_SIGN_ENTITLEMENTS to this file (or let Xcode rewrite the Debug one).
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.openselfhosting.openkey</string>
	</array>
	<key>com.apple.developer.authentication-services.autofill-credential-provider</key>
	<true/>
</dict>
</plist>
